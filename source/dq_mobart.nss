    json found = JsonObjectGet(JsonObjectGet(mappings,"ids"),id);
    if (JsonGetType(found) == JSON_TYPE_OBJECT) return found;
    json refs = JsonObjectGet(quest,"resrefs"); int i;
    for (i = 0; i < JsonGetLength(refs); i++)
