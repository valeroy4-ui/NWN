// Match the source crop to the actual frame ratio. Both axes then use the
// same scale with STRETCH; FILL never sees the aspect ratio of the whole atlas.
json DQA_Region(json region, float width, float height)
{
    float x = JsonGetFloat(JsonObjectGet(region,"x"));
    float y = JsonGetFloat(JsonObjectGet(region,"y"));
    float w = JsonGetFloat(JsonObjectGet(region,"w"));
    float h = JsonGetFloat(JsonObjectGet(region,"h"));
    if (width <= 0.0 || height <= 0.0 || w <= 0.0 || h <= 0.0) return NuiRect(0.0,0.0,1.0,1.0);
    float ratio = width/height;
    if (w/h > ratio) { float cropped = h*ratio; x += (w-cropped)/2.0; w = cropped; }
    else { float cropped = w/ratio; y += (h-cropped)/2.0; h = cropped; }
    return NuiRect(x,y,w,h);
}
